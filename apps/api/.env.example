# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# In production this must be a dedicated login role that is a member of wnx_app,
# not the database superuser (see docs/adr/0003-postgresql-rls.md).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/watchersnex
DATABASE_POOL_MAX=10
